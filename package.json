{
  "name": "synapse-ui",
  "productName": "SYNAPSE-UI",
  "version": "3.0.0-alpha.1",
  "description": "SYNAPSE-UI \u2014 A modular, GPU-accelerated neural visualization and futuristic terminal environment built upon eDEX-UI.",
  "keywords": [
    "edex-ui",
    "terminal",
    "electron",
    "neural-network",
    "visualization",
    "threejs",
    "webgl",
    "system-monitor"
  ],
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs && electron .",
    "start:dev": "node scripts/build.mjs && electron . --dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "bench": "node scripts/build.mjs && node scripts/bench.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "rebuild:native": "electron-builder install-app-deps",
    "dist": "node scripts/build.mjs --production && electron-builder --publish never",
    "dist:linux": "node scripts/build.mjs --production && electron-builder --linux --publish never",
    "dist:win": "node scripts/build.mjs --production && electron-builder --win --publish never",
    "dist:mac": "node scripts/build.mjs --production && electron-builder --mac --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwashX-dev/Synapse-UI.git"
  },
  "author": "SYNAPSE-UI contributors (fork of eDEX-UI by Gabriel 'Squared' SAILLARD)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/SwashX-dev/Synapse-UI/issues"
  },
  "homepage": "https://github.com/SwashX-dev/Synapse-UI#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "systeminformation": "5.33.19"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "gifenc": "1.0.3",
    "smol-toml": "1.9.1",
    "three": "0.186.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  }
}
